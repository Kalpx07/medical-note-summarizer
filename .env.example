# Replicate API token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxx

# Trainable base model version. Verify the latest hash at
# https://replicate.com/meta/llama-2-7b/train before running.
BASE_MODEL_VERSION=meta/llama-2-7b:73001d654114dad81ec65da3b834e2f691af1e1526453189b7bf36fb3f32d0f9

# Create an empty model at https://replicate.com/create first
DESTINATION_MODEL=your-username/llama2-med-summarizer

# Public raw URL of data/train.jsonl (GitHub gist raw link works well)
TRAIN_DATA_URL=https://gist.githubusercontent.com/you/xxxx/raw/train.jsonl

# After training succeeds, paste the version string printed by train.py
FINETUNED_MODEL=your-username/llama2-med-summarizer:versionhash

# For deploy/push_to_hf.py
HF_TOKEN=hf_xxxxxxxxxxxx
